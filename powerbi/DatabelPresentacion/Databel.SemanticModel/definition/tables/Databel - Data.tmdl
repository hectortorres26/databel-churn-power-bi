		lineageTag: 2a24b181-e225-4e7d-a226-0ce277910547

	measure 'Llamadas de servicio medias' = AVERAGE('Databel - Data'[Customer Service Calls])
		formatString: 0.00
		displayFolder: Indicadores
		lineageTag: ed5af18b-3930-48a2-b6b3-813757ac5867

	measure Filas = COUNTROWS('Databel - Data')
		formatString: #,0
		displayFolder: Indicadores
		lineageTag: f99ff6e6-8e90-43d0-afe8-c8e1adbb565e

	measure 'IDs duplicados' = [Filas] - [Clientes]
