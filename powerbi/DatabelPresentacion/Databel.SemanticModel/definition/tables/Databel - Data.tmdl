table 'Databel - Data'
	lineageTag: f5d08f5f-30e7-429a-bd29-020c68ff2079

	measure Clientes = DISTINCTCOUNT('Databel - Data'[Customer ID])
		formatString: #,0
		displayFolder: Indicadores
		lineageTag: 39666bc7-cc94-4911-8fdb-172bb202a0d9

	measure Bajas = CALCULATE([Clientes], KEEPFILTERS('Databel - Data'[Churn Label] = "Yes"))
		formatString: #,0
		displayFolder: Indicadores
		lineageTag: 1fdeb122-b0fd-4c0a-8e7d-feb40f0949c3

	measure 'Tasa de abandono' = DIVIDE([Bajas], [Clientes])
		formatString: 0.00%
		displayFolder: Indicadores
		lineageTag: 32a7e4e1-4664-4520-8875-9b1a7c20e3fb

	measure 'Clientes retenidos' = CALCULATE([Clientes], KEEPFILTERS('Databel - Data'[Churn Label] = "No"))
