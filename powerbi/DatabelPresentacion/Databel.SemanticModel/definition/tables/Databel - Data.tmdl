		displayFolder: Indicadores
		lineageTag: 5327df5f-e1ae-48fd-938e-84e2f117d06f

	measure 'Bajas sin motivo' = CALCULATE([Bajas], KEEPFILTERS('Databel - Data'[Motivo de abandono] = "Sin motivo informado"))
		formatString: #,0
		displayFolder: Indicadores
		lineageTag: c95b4ad6-6f41-454c-8aed-bc6d827f0615

	measure 'Cargo mensual medio' = AVERAGE('Databel - Data'[Monthly Charge])
